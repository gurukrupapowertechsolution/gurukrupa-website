lerna-debug.log*

node_modules
dist
dist-ssr

# Never commit environment files. Vite inlines every VITE_-prefixed value into
# the built JavaScript, so anything here is public by design — but the file may
# still hold a staging URL or a key that was pasted in "just for a minute", and
# a committed secret is permanently in the repository's history.
.env
.env.*
!.env.example
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
